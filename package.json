{
  "name": "indiecrafts-platform",
  "private": true,
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @indiecrafts/web start",
    "lint": "turbo run lint",
    "tsc": "turbo run tsc",
    "verify": "pnpm --filter @indiecrafts/web verify && node scripts/tags-report.mjs --check && pnpm lint:scripts && pnpm test:scripts",
    "verify:quick": "pnpm --filter @indiecrafts/web verify:quick",
    "seed": "pnpm --filter @indiecrafts/web seed",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "e2e": "pnpm --filter @indiecrafts/web e2e",
    "storybook": "pnpm --filter @indiecrafts/storybook storybook",
    "storybook:build": "pnpm --filter @indiecrafts/storybook storybook:build",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "docs:install": "npm --prefix docs install",
    "docs": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build",
    "prepare": "husky",
    "agents:sync": "bash scripts/sync-agents.sh",
    "test:stories": "pnpm --filter @indiecrafts/storybook test:stories",
    "tags:report": "node scripts/tags-report.mjs",
    "tags:check": "node scripts/tags-report.mjs --check",
    "lint:scripts": "npx --yes shellcheck --severity=warning scripts/*.sh",
    "test:scripts": "node --test scripts/*.test.mjs",
    "clean": "bash scripts/clean.sh",
    "scan:placeholders": "node scripts/scan-placeholders.mjs",
    "sanity:typegen": "pnpm --filter @indiecrafts/web sanity:typegen",
    "doctor:env": "pnpm --filter @indiecrafts/web doctor:env",
    "content:import": "pnpm --filter @indiecrafts/web content:import",
    "subscribers:export": "pnpm --filter @indiecrafts/web subscribers:export",
    "backup:web:sanity": "pnpm --filter @indiecrafts/web backup:web:sanity",
    "backup:web:d1:dev": "pnpm --filter @indiecrafts/web backup:web:d1:dev",
    "backup:web:d1:staging": "pnpm --filter @indiecrafts/web backup:web:d1:staging",
    "backup:web:d1:prod": "pnpm --filter @indiecrafts/web backup:web:d1:prod",
    "preview:web:cf": "pnpm --filter @indiecrafts/web preview:cf",
    "deploy:web:dev": "pnpm --filter @indiecrafts/web deploy:web:dev",
    "deploy:web:staging": "pnpm --filter @indiecrafts/web deploy:web:staging",
    "deploy:web:prod": "pnpm --filter @indiecrafts/web deploy:web:prod",
    "secrets:sync:web:dev": "pnpm --filter @indiecrafts/web secrets:sync:web:dev",
    "secrets:sync:web:staging": "pnpm --filter @indiecrafts/web secrets:sync:web:staging",
    "secrets:sync:web:prod": "pnpm --filter @indiecrafts/web secrets:sync:web:prod",
    "infra:web:init": "node scripts/infra.mjs web init dev",
    "infra:web:plan:dev": "node scripts/infra.mjs web plan dev",
    "infra:web:plan:staging": "node scripts/infra.mjs web plan staging",
    "infra:web:plan:prod": "node scripts/infra.mjs web plan prod",
    "infra:web:apply:dev": "node scripts/infra.mjs web apply dev",
    "infra:web:apply:staging": "node scripts/infra.mjs web apply staging",
    "infra:web:apply:prod": "node scripts/infra.mjs web apply prod",
    "infra:web:output:prod": "node scripts/infra.mjs web output prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "^2.10.9",
    "vitest": "^3.2.7"
  }
}
