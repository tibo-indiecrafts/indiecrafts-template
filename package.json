{
  "name": "indiecrafts-platform",
  "private": true,
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @indiecrafts/website start",
    "lint": "turbo run lint",
    "tsc": "turbo run tsc",
    "verify": "pnpm tokens:check && turbo run verify && node code/shared/scripts/checks/tags-report.mjs --check && pnpm lint:scripts && pnpm test:scripts && node code/shared/scripts/checks/delivery-canary.mjs",
    "verify:quick": "pnpm --filter @indiecrafts/website verify:quick",
    "tokens:build": "pnpm --filter @indiecrafts/ui-tokens tokens:build",
    "tokens:check": "pnpm --filter @indiecrafts/ui-tokens tokens:check",
    "seed": "pnpm --filter @indiecrafts/website seed",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:workers": "pnpm --filter @indiecrafts/api --filter @indiecrafts/cron --filter @indiecrafts/workers test",
    "e2e": "pnpm --filter @indiecrafts/website e2e",
    "storybook": "pnpm --filter @indiecrafts/storybook storybook",
    "storybook:build": "pnpm --filter @indiecrafts/storybook storybook:build",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "docs:install": "npm --prefix code/docs install",
    "docs": "npm --prefix code/docs run docs:dev",
    "docs:build": "npm --prefix code/docs run docs:build",
    "prepare": "husky",
    "agents:sync": "bash code/shared/scripts/dev/sync-agents.sh",
    "test:stories": "pnpm --filter @indiecrafts/storybook test:stories",
    "tags:report": "node code/shared/scripts/checks/tags-report.mjs",
    "tags:check": "node code/shared/scripts/checks/tags-report.mjs --check",
    "lint:scripts": "npx --yes shellcheck --severity=warning code/shared/scripts/dev/*.sh",
    "test:scripts": "node --test \"code/shared/scripts/**/*.test.mjs\" \"code/projects/web/surfaces/website/scripts/**/*.test.mjs\"",
    "clean": "bash code/shared/scripts/dev/clean.sh",
    "scan:placeholders": "node code/shared/scripts/checks/scan-placeholders.mjs",
    "doctor:env": "pnpm --filter @indiecrafts/website doctor:env",
    "content:import": "pnpm --filter @indiecrafts/website content:import",
    "subscribers:export": "pnpm --filter @indiecrafts/website subscribers:export",
    "backup:content:prod": "node code/shared/scripts/data/backup.mjs content prod",
    "backup:content:prod:remote": "node code/shared/scripts/data/backup.mjs content prod --remote",
    "backup:all:dev": "node code/shared/scripts/data/backup.mjs --all dev",
    "backup:all:staging": "node code/shared/scripts/data/backup.mjs --all staging",
    "backup:all:prod": "node code/shared/scripts/data/backup.mjs --all prod",
    "db:migrate": "node code/shared/scripts/data/migrate.mjs",
    "domains:print": "node code/shared/scripts/deploy/domains.mjs print",
    "domains:url": "node code/shared/scripts/deploy/domains.mjs url",
    "preview:website:cf": "pnpm --filter @indiecrafts/website preview:cf",
    "deploy:website:dev": "pnpm --filter @indiecrafts/website deploy:website:dev",
    "deploy:website:staging": "pnpm --filter @indiecrafts/website deploy:website:staging",
    "deploy:website:prod": "pnpm --filter @indiecrafts/website deploy:website:prod",
    "deploy:admin:dev": "pnpm --filter @indiecrafts/admin deploy:admin:dev",
    "deploy:admin:staging": "pnpm --filter @indiecrafts/admin deploy:admin:staging",
    "deploy:admin:prod": "pnpm --filter @indiecrafts/admin deploy:admin:prod",
    "deploy:api:dev": "pnpm --filter @indiecrafts/api deploy:api:dev",
    "deploy:api:staging": "pnpm --filter @indiecrafts/api deploy:api:staging",
    "deploy:api:prod": "pnpm --filter @indiecrafts/api deploy:api:prod",
    "deploy:cron:dev": "pnpm --filter @indiecrafts/cron deploy:cron:dev",
    "deploy:cron:staging": "pnpm --filter @indiecrafts/cron deploy:cron:staging",
    "deploy:cron:prod": "pnpm --filter @indiecrafts/cron deploy:cron:prod",
    "deploy:workers:dev": "pnpm --filter @indiecrafts/workers deploy:workers:dev",
    "deploy:workers:staging": "pnpm --filter @indiecrafts/workers deploy:workers:staging",
    "deploy:workers:prod": "pnpm --filter @indiecrafts/workers deploy:workers:prod",
    "deploy:mobile:dev": "pnpm --filter @indiecrafts/mobile deploy:mobile:dev",
    "deploy:mobile:staging": "pnpm --filter @indiecrafts/mobile deploy:mobile:staging",
    "deploy:mobile:prod": "pnpm --filter @indiecrafts/mobile deploy:mobile:prod",
    "deploy:hybrid:dev": "pnpm --filter @indiecrafts/hybrid deploy:hybrid:dev",
    "deploy:hybrid:staging": "pnpm --filter @indiecrafts/hybrid deploy:hybrid:staging",
    "deploy:hybrid:prod": "pnpm --filter @indiecrafts/hybrid deploy:hybrid:prod",
    "deploy:all:dev": "node code/shared/scripts/deploy/all.mjs dev",
    "deploy:all:staging": "node code/shared/scripts/deploy/all.mjs staging",
    "deploy:all:prod": "node code/shared/scripts/deploy/all.mjs prod",
    "secrets:sync:website:dev": "pnpm --filter @indiecrafts/website secrets:sync:website:dev",
    "secrets:sync:website:staging": "pnpm --filter @indiecrafts/website secrets:sync:website:staging",
    "secrets:sync:website:prod": "pnpm --filter @indiecrafts/website secrets:sync:website:prod",
    "setup:kv": "pnpm --filter @indiecrafts/website setup:kv",
    "infra:website:init": "node code/shared/scripts/infra/run.mjs website init dev",
    "infra:website:plan:dev": "node code/shared/scripts/infra/run.mjs website plan dev",
    "infra:website:plan:staging": "node code/shared/scripts/infra/run.mjs website plan staging",
    "infra:website:plan:prod": "node code/shared/scripts/infra/run.mjs website plan prod",
    "infra:website:apply:dev": "node code/shared/scripts/infra/run.mjs website apply dev",
    "infra:website:apply:staging": "node code/shared/scripts/infra/run.mjs website apply staging",
    "infra:website:apply:prod": "node code/shared/scripts/infra/run.mjs website apply prod",
    "infra:website:output:prod": "node code/shared/scripts/infra/run.mjs website output prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "vitest": "^3.2.7"
  }
}
