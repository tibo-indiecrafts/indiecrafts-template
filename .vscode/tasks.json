{
  "version": "2.0.0",
  // Every root package.json script, runnable from Terminal → Run Task (Cmd/Ctrl-Shift-P → "Run Task").
  // Labels mirror the script names; `detail` documents each. Keep in sync with package.json when scripts
  // change. (VS Code also auto-detects npm scripts under the "npm" task type — this file adds the docs,
  // grouping, background panels, and problem matchers that auto-detection can't.)
  // `prepare` (husky lifecycle) is intentionally omitted — it runs on install, not on demand.
  // Plus a few curated PER-APP tasks — label `<app>: <name>` (e.g. `website: verify:contrast`) — that
  // have no root script. `pnpm check:tasks` guards the sync: every root script must have a task, and a
  // task with no matching script must use the `<app>: ` prefix (else it is flagged as a stale orphan).
  "tasks": [
    // ── Dev & build ──────────────────────────────────────────────────────
    {
      "label": "dev",
      "detail": "turbo run dev — the app on :3000",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "detail": "turbo run build — production build, all workspaces",
      "type": "shell",
      "command": "pnpm build",
      "group": "build",
