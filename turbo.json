{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build:cf": {
      "dependsOn": ["^build"],
      "outputs": [".open-next/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "storybook": { "cache": false, "persistent": true },
    "storybook:build": { "outputs": ["storybook-static/**"] },
    "lint": {},
    "tsc": { "outputs": ["*.tsbuildinfo"] },
    "test": {},
    "verify": { "cache": false }
  }
}
