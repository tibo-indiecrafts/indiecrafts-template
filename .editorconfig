# EditorConfig — aligns non-VS-Code editors with Prettier. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: trailing whitespace can be a hard line break — don't trim.
[*.md]
trim_trailing_whitespace = false

# Make files edited by tools follow their own conventions.
[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
