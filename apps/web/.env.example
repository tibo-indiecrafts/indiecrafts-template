# =============================================================
# Environment variables. All optional — the template runs as-is
# without any of these set.
# =============================================================

# Production origin (scheme + host, no trailing slash), e.g.
# https://acme.com. Feeds `site.url` → canonical URLs, sitemap, JSON-LD,
# OG tags, and robots.txt. Set it ONLY on the production deployment: while
# unset the site keeps the placeholder origin, `isSiteConfigured` stays
# false, and robots.txt serves a full disallow (see below).
NEXT_PUBLIC_SITE_URL=

# Override the detected environment for `getCurrentEnvironment()` in
# `src/config/types.ts`. Drives the CSP in next.config.ts AND robots.txt:
# only "production" is indexable — every other environment (dev, preview,
# staging, test) serves `Disallow: /` so it stays quiet when online. Valid
# values: "development" | "test" | "staging" | "production". When unset,
# NODE_ENV decides. Set "staging" on preview deploys for the tighter CSP.
NEXT_PUBLIC_ENVIRONMENT=

# ── Sanity ──────────────────────────────────────────────────
# Public values — safe to expose. Find them at https://www.sanity.io/manage
# under your project's API tab. Required for the embedded Studio at /studio
# and for any `@/sanity/client` queries.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin API version so query semantics stay stable; bump intentionally.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only read token (Viewer role is enough). Required for draft-mode
# preview at /api/draft-mode/enable + the `sanityFetchLive` wrapper used
# by blog routes. Issue at sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=

# Write token (Editor role) — used by `pnpm seed:blog` to insert demo
# content. NOT needed at runtime; safe to leave unset in production.
SANITY_API_WRITE_TOKEN=
