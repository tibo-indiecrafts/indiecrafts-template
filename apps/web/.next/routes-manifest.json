{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.sanity.io wss://*.api.sanity.io https://registry.npmjs.org; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/brand/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/brand(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/logo.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/logo\\.svg(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/studio/[[...tool]]",
      "regex": "^/studio(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPtool": "nxtPtool"
      },
      "namedRegex": "^/studio(?:/(?<nxtPtool>.+?))?(?:/)?$"
    },
    {
      "page": "/[locale]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/author",
      "regex": "^/([^/]+?)/author(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/author(?:/)?$"
    },
    {
      "page": "/[locale]/author/[slug]",
      "regex": "^/([^/]+?)/author/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/author/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/blog",
      "regex": "^/([^/]+?)/blog(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog(?:/)?$"
    },
    {
      "page": "/[locale]/blog/atom.xml",
      "regex": "^/([^/]+?)/blog/atom\\.xml(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/atom\\.xml(?:/)?$"
    },
    {
      "page": "/[locale]/blog/category",
      "regex": "^/([^/]+?)/blog/category(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/category(?:/)?$"
    },
    {
      "page": "/[locale]/blog/category/[slug]",
      "regex": "^/([^/]+?)/blog/category/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/category/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/blog/rss.xml",
      "regex": "^/([^/]+?)/blog/rss\\.xml(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/rss\\.xml(?:/)?$"
    },
    {
      "page": "/[locale]/blog/tag",
      "regex": "^/([^/]+?)/blog/tag(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/tag(?:/)?$"
    },
    {
      "page": "/[locale]/blog/tag/[slug]",
      "regex": "^/([^/]+?)/blog/tag/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/tag/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/blog/[slug]",
      "regex": "^/([^/]+?)/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/blog/[slug]/md",
      "regex": "^/([^/]+?)/blog/([^/]+?)/md(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/blog/(?<nxtPslug>[^/]+?)/md(?:/)?$"
    },
    {
      "page": "/[locale]/legal",
      "regex": "^/([^/]+?)/legal(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/legal(?:/)?$"
    },
    {
      "page": "/[locale]/llms/[id]",
      "regex": "^/([^/]+?)/llms/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/llms/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/llms-full.txt",
      "regex": "^/([^/]+?)/llms\\-full\\.txt(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/llms\\-full\\.txt(?:/)?$"
    },
    {
      "page": "/[locale]/llms.txt",
      "regex": "^/([^/]+?)/llms\\.txt(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/llms\\.txt(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/draft-mode/disable",
      "regex": "^/api/draft\\-mode/disable(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/draft\\-mode/disable(?:/)?$"
    },
    {
      "page": "/api/draft-mode/enable",
      "regex": "^/api/draft\\-mode/enable(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/draft\\-mode/enable(?:/)?$"
    },
    {
      "page": "/api/i18n/translated-slug",
      "regex": "^/api/i18n/translated\\-slug(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/i18n/translated\\-slug(?:/)?$"
    },
    {
      "page": "/maintenance",
      "regex": "^/maintenance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/maintenance(?:/)?$"
    },
    {
      "page": "/manifest.webmanifest",
      "regex": "^/manifest\\.webmanifest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifest\\.webmanifest(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}