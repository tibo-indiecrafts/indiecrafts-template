{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm tsc)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm verify:quick)",
      "Bash(pnpm verify:contrast)",
      "Bash(pnpm verify)",
      "Bash(pnpm doctor:changed)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "worktree": {
    "sparsePaths": [".claude", "code"]
  }
}
