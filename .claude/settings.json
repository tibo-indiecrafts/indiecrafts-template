{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm tsc)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm verify:quick)",
      "Bash(pnpm verify:contrast)",
      "Bash(pnpm verify)",
      "Bash(pnpm doctor:changed)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/.turbo/**)",
      "Read(**/.vitepress/dist/**)",
      "Read(**/.vitepress/cache/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" ] || node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Guard (protected paths)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/a11y-check.mjs\" ] || node \"$CLAUDE_PROJECT_DIR/.claude/hooks/a11y-check.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking accessibility"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/a11y-check.mjs\" ] || node \"$CLAUDE_PROJECT_DIR/.claude/hooks/a11y-check.mjs\"",
            "timeout": 30,
            "statusMessage": "Accessibility deep pass"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/change-hygiene.sh\" ] || \"$CLAUDE_PROJECT_DIR/.claude/hooks/change-hygiene.sh\"",
            "timeout": 10,
            "statusMessage": "Change-hygiene (docs + tests)"
          }
        ]
      }
    ]
  }
}
