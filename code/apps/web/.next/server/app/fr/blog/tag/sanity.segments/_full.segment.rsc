ir vos besoins","body":"Personnalisation poussée, contrôle total et flux de travail assistés par l'IA — le tout dans un seul package.","items":{"customizable":{"title":"Personnalisable","body":"Des options de personnalisation poussées qui vous laissent ajuster chaque aspect à vos besoins."},"fullControl":{"title":"Contrôle total","body":"Des éléments de design à la logique, vous gardez la main pour créer une expérience unique."},"poweredByAi":{"title":"Propulsé par l'IA","body":"Valeurs par défaut intelligentes, suggestions contextuelles et workflows automatisés sur des primitives IA modernes."}}},"cta":{"title":"Lancez-vous","body":"Laissez-nous votre email — on vous envoie les premières étapes.","emailPlaceholder":"Votre adresse email","submit":"Commencer"},"pricing":{"title":"Une tarification qui évolue avec vous","body":"Commencez gratuitement. Évoluez quand vous avez besoin de plus de sièges, de stockage ou de support.","tiers":{"free":{"name":"Gratuit","price":"0 €","period":"/ mois","description":"Par éditeur","cta":"Commencer","features":{"analytics":"Tableau de bord analytique de base","storage":"5 Go de stockage cloud","support":"Support email et chat"}},"pro":{"name":"Pro","price":"19 €","period":"/ mois","description":"Par éditeur","cta":"Commencer","badge":"Populaire","features":{"everything":"Tout le plan Gratuit","community":"Accès au forum communautaire","singleUser":"Un seul utilisateur","templates":"Accès aux templates de base","mobile":"Application mobile","reports":"1 rapport personnalisé par mois","updates":"Mises à jour mensuelles","security":"Sécurité standard"}},"startup":{"name":"Startup","price":"29 €","period":"/ mois","description":"Par éditeur","cta":"Commencer","features":{"everything":"Tout le plan Pro","storage":"50 Go de stockage cloud","support":"Support email et chat prioritaire"}}}},"testimonials":{"label":"Témoignages","quotes":{"lovelace":{"quote":"Forké une fois, trois sites clients livrés en une semaine. Le template que j'aura