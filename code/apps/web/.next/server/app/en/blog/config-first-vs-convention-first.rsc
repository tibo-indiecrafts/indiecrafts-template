d pre-built page templates you can fork per client.","keywords":"next.js template, indiecrafts, config-first, modular website","faq":[{"question":"Do I need to touch code to rebrand?","answer":"No. Point the config at your brand — name, colors, logo, languages — and the whole site follows. You only write code to add new sections or logic."},{"question":"How does adding a language work?","answer":"Add one row to the locale config and drop in a translations file. URLs, SEO, the sitemap, and the language switcher all update on their own."},{"question":"Is it SEO-ready out of the box?","answer":"Yes. Titles, descriptions, canonical URLs, hreflang, Open Graph, and JSON-LD — including this FAQ's rich-result markup — are generated from your content."},{"question":"Can I turn features off?","answer":"Every surface — blog, legal page, RSS, LLM endpoints, this FAQ — is a single flag. Flip it off and its routes, links, and sitemap entries disappear together."}],"hero":{"eyebrow":"Config-first template","title":"Ship client websites in a weekend","subtitle":"A modular Next.js foundation with i18n, SEO, a11y and Tailwind wired up — edit config, not code."},"blocks":{"features":{"title":"Built to cover your needs","body":"Extensive customization, full control, and AI-assisted workflows — in one tidy package.","items":{"customizable":{"title":"Customizable","body":"Extensive customization options, allowing you to tailor every aspect to meet your specific needs."},"fullControl":{"title":"You have full control","body":"From design elements to functionality, complete control to create a unique and personalized experience."},"poweredByAi":{"title":"Powered by AI","body":"Smart defaults, intelligent suggestions, and automated workflows built on modern AI primitives."}}},"cta":{"title":"Start Building","body":"Drop your email — we'll send you the first steps.","emailPlaceholder":"Your email address","submit":"Get started"},"pricing":{"title":"Pricing that scales with you","body":"Start free. Upgrade when you need more seats, storage, or support.","tiers":{"free":{"name":"Free","price":"$$0","period":"/ mo","description":"Per editor","cta":"Get Started","features":{"analytics":"Basic Analytics Dashboard","storage":"5GB Cloud Storage","support":"Email and Chat Support"}},"pro":{"name":"Pro","price":"$$19","period":"/ mo","description":"Per editor","cta":"Get Started","badge":"Popular","features":{"everything":"Everything in Free Plan","community":"Access to Community Forum","singleUser":"Single User Access","templates":"Access to Basic Templates","mobile":"Mobile App Access","reports":"1 Custom Report Per Month","updates":"Monthly Product Updates","security":"Standard Security Features"}},"startup":{"name":"Startup","price":"$$29","period":"/ mo","description":"Per editor","cta":"Get Started","features":{"everything":"Everything in Pro Plan","storage":"50GB Cloud Storage","support":"Priority Email and Chat Support"}}}},"testimonials":{"label":"Testimonials","quotes":{"lovelace":{"quote":"Forked once, shipped three client sites in a week. This is the template I wish I'd written myself.","author":"Ada Lovelace","role":"Founder, Analytic Studio"}}},"featured":{"eyebrow":"Featured","title":"Notes from the studio","body":"Guides, teardowns, and field notes on shipping client sites faster.","viewAll":"All articles"},"icons":{"eyebrow":"Icons","title":"One interface, three icon sets","body":"Lucide for UI glyphs, Reicon for outline and filled weights, and Reicon Brands for logos in their official colors.","lucide":"Lucide — UI glyphs","reicon":"Reicon — outline + filled","brands":"Reicon Brands — official colors"},"morphicons":{"eyebrow":"Motion","title":"Icons that morph, not swap","body":"Morphicons animates the transition between any two icons — the shape flows from one shape to the next instead of cutting.","hint":"Tap any icon to morph it. Honors reduced-motion.","icons":{"menu":"Menu / close","play":"Play / pause","theme":"Light / dark","volume":"Volume / muted","bell":"Notifications on / off","copy":"Copy / copied"}}}}},"faq":{"eyebrow":"FAQ","title":"Frequently asked questions","subtitle":"Everything you need to know about the template. Can't find an answer? Reach out."}},"now":"$undefined","timeZone":"Europe/Zurich","children":"$L16"}]
