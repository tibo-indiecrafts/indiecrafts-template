{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/blog/layout,_N_T_/[locale]/blog/category/layout,_N_T_/[locale]/blog/category/page,_N_T_/en/blog/category,sanity:s1:pKZ/Rg,sanity:s1:EkViHQ"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/blog/category/__PAGE__",
    "/$d$locale/blog/category",
    "/$d$locale/blog",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}