{
  "name": "@indiecrafts/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "verify:quick": "pnpm tsc && pnpm lint",
    "verify:contrast": "node scripts/check-contrast.mjs",
    "verify": "pnpm tsc && pnpm lint && pnpm format:check && pnpm verify:contrast && pnpm doctor:changed",
    "doctor": "npx react-doctor@latest --verbose",
    "doctor:changed": "npx react-doctor@latest --verbose --scope changed --base main",
    "shadscan": "pnpm dlx @shadscan/cli",
    "analyze": "ANALYZE=1 next build",
    "seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "docs:install": "npm --prefix docs install",
    "docs": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build",
    "codegraph:init": "command -v codegraph >/dev/null 2>&1 && CODEGRAPH_TELEMETRY=0 codegraph init || echo 'CodeGraph not installed (opt-in) — see docs/setup/codegraph.md'",
    "codegraph:status": "command -v codegraph >/dev/null 2>&1 && CODEGRAPH_TELEMETRY=0 codegraph status || echo 'CodeGraph not installed (opt-in) — see docs/setup/codegraph.md'",
    "prepare": ""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@portabletext/react": "^6.2.0",
    "@sanity/document-internationalization": "^6.2.27",
    "@sanity/icons": "^3.7.4",
    "@sanity/vision": "^5.26.0",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide": "^1.28.0",
    "lucide-react": "^1.9.0",
    "morphicons": "^1.2.0",
    "next": "16.2.10",
    "next-intl": "^4.9.1",
    "next-sanity": "^13.0.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "react-resizable-panels": "^4",
    "reicon-brands": "^1.0.2",
    "reicon-react": "^1.1.3",
    "sanity": "^5.26.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.4",
    "@sanity/client": "^7.22.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "0.0.0-insiders.f7d2598",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
