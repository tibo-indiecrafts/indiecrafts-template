  "component": {
    "item-ring": {
      "$type": "color",
      "$value": "{semantic.ring}"
    },
    "item-border": {
      "$type": "color",
      "$value": "{semantic.border}"
    },
    "item-muted": {
      "$type": "color",
      "$value": "{semantic.muted}"
    },
    "item-primary": {
      "$type": "color",
      "$value": "{component.primary}"
    },
    "item-muted-foreground": {
      "$type": "color",
      "$value": "{semantic.muted-foreground}"
    }
  }
}
