  "component": {
    "switch-ring": { "$type": "color", "$value": "{semantic.ring}" },
    "switch-primary": { "$type": "color", "$value": "{component.primary}" },
    "switch-input": { "$type": "color", "$value": "{component.input}" },
    "switch-background": { "$type": "color", "$value": "{semantic.background}" },
    "switch-primary-foreground": { "$type": "color", "$value": "{component.primary-foreground}" },
    "switch-foreground": { "$type": "color", "$value": "{semantic.foreground}" }
  }
}
