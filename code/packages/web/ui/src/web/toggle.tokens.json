{
  "$description": "Component token surface for toggle — colocated DTCG component-tier aliases. Sidecar (never edits the component); merged by `pnpm tokens:build`.",
  "component": {
    "toggle-muted": { "$type": "color", "$value": "{semantic.muted}" },
    "toggle-muted-foreground": {
      "$type": "color",
      "$value": "{semantic.muted-foreground}"
    },
    "toggle-ring": { "$type": "color", "$value": "{semantic.ring}" },
    "toggle-destructive": {
      "$type": "color",
      "$value": "{semantic.destructive}"
    },
    "toggle-accent": { "$type": "color", "$value": "{component.accent}" },
    "toggle-accent-foreground": {
      "$type": "color",
      "$value": "{component.accent-foreground}"
    },
    "toggle-input": { "$type": "color", "$value": "{component.input}" }
  }
}
