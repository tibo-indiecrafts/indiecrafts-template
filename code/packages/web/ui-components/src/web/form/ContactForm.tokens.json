{
  "$description": "Component token surface for ContactForm — colocated DTCG component-tier aliases. Sidecar (never edits the component); merged by `pnpm tokens:build`.",
  "component": {
    "contact-form-card": { "$type": "color", "$value": "{component.card}" },
    "contact-form-primary": {
      "$type": "color",
      "$value": "{component.primary}"
    },
    "contact-form-primary-foreground": {
      "$type": "color",
      "$value": "{component.primary-foreground}"
    },
    "contact-form-foreground": {
      "$type": "color",
      "$value": "{semantic.foreground}"
    },
    "contact-form-muted-foreground": {
      "$type": "color",
      "$value": "{semantic.muted-foreground}"
    },
    "contact-form-muted": { "$type": "color", "$value": "{semantic.muted}" },
    "contact-form-background": {
      "$type": "color",
      "$value": "{semantic.background}"
    },
    "contact-form-destructive": {
      "$type": "color",
      "$value": "{semantic.destructive}"
    }
  }
}
