      "5": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.907, 0.231, 133] }
      }
    },
    "sidebar-light": {
      "$description": "shadcn sidebar palette (light) — authored in HSL, kept as-is for value-neutrality.",
      "bg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [0, 0, 98] }
      },
      "fg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 5.9, 10] }
      },
      "primary": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 5.9, 10] }
      },
      "primary-fg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [0, 0, 98] }
      },
      "accent": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 4.8, 95.9] }
      },
      "accent-fg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 5.9, 10] }
      },
      "border": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [220, 13, 91] }
