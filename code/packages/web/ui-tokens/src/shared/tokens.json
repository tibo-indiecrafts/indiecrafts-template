      "2": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.604, 0.26, 302] }
      },
      "3": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.696, 0.165, 251] }
