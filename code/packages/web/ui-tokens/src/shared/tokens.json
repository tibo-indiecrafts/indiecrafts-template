{
  "$description": "Design tokens — DTCG v2025.10. SINGLE SOURCE OF TRUTH. Author OKLCH here; `pnpm tokens:build` generates src/generated/tokens.css (web) and src/generated/hex.ts (semantic hex mirror: PWA manifest + email). Never hand-edit the generated files. Three tiers: primitive (raw palette) -> semantic (intent, light+dark) -> component (per-component overrides). Components + semantics reference only the tier below via {ref} aliases.",
  "primitive": {
    "$description": "Raw palette — no usage opinion. Referenced by the semantic tier, never by components directly.",
    "neutral": {
      "white": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [1, 0, 0] },
        "$description": "white"
      },
      "50": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] },
        "$description": "neutral-50"
      },
      "100": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] },
        "$description": "neutral-100"
      },
      "300": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.84, 0, 0] },
        "$description": "between neutral-200 + neutral-300"
      },
      "400": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.708, 0, 0] },
        "$description": "neutral-400"
      },
      "500": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.5, 0, 0] },
        "$description": "~neutral-500 — bumped for AA on near-black"
      },
      "550": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.52, 0, 0] },
        "$description": "~neutral-550 — darkened from 500 for AA on --muted"
      },
      "900": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] },
        "$description": "neutral-900"
      },
      "925": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.18, 0, 0] },
        "$description": "between neutral-900 + neutral-950"
      },
      "950": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] },
        "$description": "neutral-950"
      }
    },
    "brand": {
      "400": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.72, 0.16, 260] },
        "$description": "indigo-400-ish (dark-mode brand)"
      },
      "500": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 260] },
        "$description": "indigo-500 (hue retuned to 260)"
      },
      "wash-light": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.9, 0.07, 260] },
        "$description": "pale indigo — light selection wash"
      },
      "wash-dark": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.4, 0.12, 260] },
        "$description": "indigo-800-ish — dark selection wash"
      }
    },
    "red": {
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.704, 0.191, 22.216]
        },
        "$description": "red-400 — dark-theme destructive (AA as text on the dark background)"
      },
      "700": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.505, 0.213, 27.518]
        },
        "$description": "red-700 — light-theme destructive (AA as text on its own /10 tint)"
      },
      "600": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.577, 0.245, 27.325]
        },
        "$description": "red-600"
      }
    },
    "chart": {
      "1": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.662, 0.225, 25.9] }
