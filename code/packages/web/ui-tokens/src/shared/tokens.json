      "ring": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [217.2, 91.2, 59.8] }
      }
    },
    "sidebar-dark": {
      "$description": "shadcn sidebar palette (dark).",
      "bg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 5.9, 10] }
      },
      "fg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 4.8, 95.9] }
      },
      "primary": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [224.3, 76.3, 48] }
      },
      "primary-fg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [0, 0, 100] }
      },
      "accent": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 3.7, 15.9] }
      },
      "accent-fg": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 4.8, 95.9] }
      },
      "border": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [240, 3.7, 15.9] }
      },
      "ring": {
        "$type": "color",
        "$value": { "colorSpace": "hsl", "components": [217.2, 91.2, 59.8] }
      }
    },
    "dimension": {
      "radius-md": {
        "$type": "dimension",
        "$value": { "value": 0.5, "unit": "rem" },
        "$description": "base corner radius"
      }
    }
  },

  "semantic": {
    "$description": "Intent, not value. Light + dark value sets — re-pointed per theme; every component follows automatically. Reference only primitives.",
    "light": {
      "background": { "$type": "color", "$value": "{primitive.neutral.white}" },
      "foreground": { "$type": "color", "$value": "{primitive.neutral.950}" },
      "muted": { "$type": "color", "$value": "{primitive.neutral.100}" },
      "muted-foreground": {
        "$type": "color",
        "$value": "{primitive.neutral.550}"
      },
      "brand": { "$type": "color", "$value": "{primitive.brand.500}" },
      "brand-foreground": {
        "$type": "color",
        "$value": "{primitive.neutral.50}"
      },
      "destructive": { "$type": "color", "$value": "{primitive.red.700}" },
      "destructive-foreground": {
        "$type": "color",
        "$value": "{primitive.neutral.50}"
      },
      "border": { "$type": "color", "$value": "{primitive.neutral.300}" },
      "illustration": {
        "$type": "color",
        "$value": "{primitive.neutral.white}",
        "$description": "white — flips to near-black in dark"
      },
      "ring": { "$type": "color", "$value": "{primitive.brand.500}" },
      "selection-bg": {
        "$type": "color",
        "$value": "{primitive.brand.wash-light}"
      },
      "selection-fg": { "$type": "color", "$value": "{primitive.neutral.950}" },
      "sidebar": { "$type": "color", "$value": "{primitive.sidebar-light.bg}" },
      "sidebar-foreground": {
        "$type": "color",
        "$value": "{primitive.sidebar-light.fg}"
      },
      "sidebar-primary": {
        "$type": "color",
        "$value": "{primitive.sidebar-light.primary}"
      },
      "sidebar-primary-foreground": {
        "$type": "color",
        "$value": "{primitive.sidebar-light.primary-fg}"
      },
      "sidebar-accent": {
        "$type": "color",
        "$value": "{primitive.sidebar-light.accent}"
      },
      "sidebar-accent-foreground": {
        "$type": "color",
        "$value": "{primitive.sidebar-light.accent-fg}"
      },
      "sidebar-border": {
        "$type": "color",
        "$value": "{primitive.sidebar-light.border}"
      },
      "sidebar-ring": {
        "$type": "color",
        "$value": "{primitive.sidebar-light.ring}"
      }
    },
    "dark": {
      "background": { "$type": "color", "$value": "{primitive.neutral.950}" },
      "foreground": { "$type": "color", "$value": "{primitive.neutral.50}" },
      "muted": { "$type": "color", "$value": "{primitive.neutral.900}" },
      "muted-foreground": {
        "$type": "color",
        "$value": "{primitive.neutral.400}"
      },
      "brand": {
        "$type": "color",
        "$value": "{primitive.brand.400}",
        "$description": "lighter + less saturated for AA on black — not a strict grayscale inversion"
      },
      "brand-foreground": {
        "$type": "color",
        "$value": "{primitive.neutral.950}"
      },
      "destructive": { "$type": "color", "$value": "{primitive.red.400}" },
      "destructive-foreground": {
        "$type": "color",
        "$value": "{primitive.neutral.950}"
      },
      "border": { "$type": "color", "$value": "{primitive.neutral.500}" },
      "illustration": { "$type": "color", "$value": "{primitive.neutral.925}" },
      "ring": { "$type": "color", "$value": "{primitive.brand.400}" },
      "selection-bg": {
        "$type": "color",
        "$value": "{primitive.brand.wash-dark}"
      },
      "selection-fg": { "$type": "color", "$value": "{primitive.neutral.50}" },
      "sidebar": { "$type": "color", "$value": "{primitive.sidebar-dark.bg}" },
      "sidebar-foreground": {
        "$type": "color",
        "$value": "{primitive.sidebar-dark.fg}"
      },
      "sidebar-primary": {
        "$type": "color",
        "$value": "{primitive.sidebar-dark.primary}"
      },
      "sidebar-primary-foreground": {
        "$type": "color",
        "$value": "{primitive.sidebar-dark.primary-fg}"
      },
      "sidebar-accent": {
        "$type": "color",
        "$value": "{primitive.sidebar-dark.accent}"
      },
      "sidebar-accent-foreground": {
        "$type": "color",
        "$value": "{primitive.sidebar-dark.accent-fg}"
      },
      "sidebar-border": {
        "$type": "color",
        "$value": "{primitive.sidebar-dark.border}"
      },
      "sidebar-ring": {
        "$type": "color",
        "$value": "{primitive.sidebar-dark.ring}"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{primitive.dimension.radius-md}"
    }
  },

  "component": {
    "$description": "Per-component overrides / shadcn utility aliases. Reference only semantic tokens — so they re-theme automatically (dark mode never touches this tier).",
    "primary": { "$type": "color", "$value": "{semantic.brand}" },
    "primary-foreground": {
      "$type": "color",
      "$value": "{semantic.brand-foreground}"
    },
    "secondary": { "$type": "color", "$value": "{semantic.muted}" },
    "secondary-foreground": {
      "$type": "color",
      "$value": "{semantic.foreground}"
    },
    "accent": { "$type": "color", "$value": "{semantic.muted}" },
    "accent-foreground": {
      "$type": "color",
      "$value": "{semantic.foreground}"
    },
    "card": { "$type": "color", "$value": "{semantic.background}" },
    "card-foreground": { "$type": "color", "$value": "{semantic.foreground}" },
    "popover": { "$type": "color", "$value": "{semantic.background}" },
    "popover-foreground": {
      "$type": "color",
      "$value": "{semantic.foreground}"
    },
    "input": { "$type": "color", "$value": "{semantic.border}" },
    "color-1": { "$type": "color", "$value": "{primitive.chart.1}" },
    "color-2": { "$type": "color", "$value": "{primitive.chart.2}" },
    "color-3": { "$type": "color", "$value": "{primitive.chart.3}" },
    "color-4": { "$type": "color", "$value": "{primitive.chart.4}" },
    "color-5": { "$type": "color", "$value": "{primitive.chart.5}" }
  }
}
