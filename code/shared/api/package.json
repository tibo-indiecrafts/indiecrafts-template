{
  "name": "@indiecrafts/shared-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --port 8787 --inspector-port 9229 --persist-to ../../../.wrangler/state",
    "dev:remote": "wrangler dev --env dev --remote --port 8787 --inspector-port 9229",
    "cf-typegen": "wrangler types",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm tsc && pnpm test",
    "deploy:api:dev": "node ../scripts/deploy/worker.mjs api dev",
    "deploy:api:staging": "node ../scripts/deploy/worker.mjs api staging",
    "deploy:api:prod": "node ../scripts/deploy/worker.mjs api prod",
    "secrets:sync:api:dev": "node ../scripts/data/secrets.mjs api dev",
    "secrets:sync:api:staging": "node ../scripts/data/secrets.mjs api staging",
    "secrets:sync:api:prod": "node ../scripts/data/secrets.mjs api prod",
    "tail:dev": "wrangler tail --env dev",
    "tail:staging": "wrangler tail --env staging",
    "tail:prod": "wrangler tail --env prod"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.7",
    "@indiecrafts/packages-shared-announcement": "workspace:*",
    "@indiecrafts/packages-shared-compliance": "workspace:*",
    "@indiecrafts/packages-shared-config": "workspace:*",
    "@indiecrafts/packages-shared-gated-delivery": "workspace:*",
    "@indiecrafts/packages-shared-logger": "workspace:*",
    "@indiecrafts/packages-shared-security": "workspace:*",
    "@indiecrafts/packages-shared-security-events": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250321.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  }
}
