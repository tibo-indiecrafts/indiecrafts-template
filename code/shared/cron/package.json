{
  "name": "@indiecrafts/shared-cron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --port 8789 --inspector-port 9231 --test-scheduled --persist-to ../../../.wrangler/state",
    "dev:remote": "wrangler dev --env dev --remote --port 8789 --inspector-port 9231",
    "cf-typegen": "wrangler types",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm tsc && pnpm test",
    "deploy:cron:dev": "node ../scripts/deploy/worker.mjs cron dev",
    "deploy:cron:staging": "node ../scripts/deploy/worker.mjs cron staging",
    "deploy:cron:prod": "node ../scripts/deploy/worker.mjs cron prod",
    "tail:dev": "wrangler tail --env dev",
    "tail:staging": "wrangler tail --env staging",
    "tail:prod": "wrangler tail --env prod"
  },
  "dependencies": {
    "@indiecrafts/packages-shared-config": "workspace:*",
    "@indiecrafts/packages-shared-logger": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250321.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  }
}
