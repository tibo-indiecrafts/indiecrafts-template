# =============================================================
# Desktop app environment (electron-vite). VITE_* is inlined into
# the RENDERER bundle — PUBLIC values only, never a secret.
# =============================================================

# ── Authentication (Clerk) — opt-in ─────────────────────────
# With no publishable key the app runs exactly as before (the provider is not
# mounted). Set it to turn on sign-in in the renderer (email OTP + Google via the
# system-browser deep link). PUBLIC key only — the Clerk SECRET key never ships in a
# desktop binary. dashboard.clerk.com → API keys. For a PROD instance on a custom
# domain, also add `https://clerk.<your-domain>` to the CSP in src/renderer/index.html.
VITE_CLERK_PUBLISHABLE_KEY=

# ── Announcements (shared api → the renderer) ───────────────
# The logged-in announcement banner/toast fetch the shared api's PUBLIC /v1/announcements.
# The renderer can only read VITE_* — set the api Worker origin here (public content).
# Unset → no announcements show. (The main process's API_URL below is a separate, server
# var for the session sink.)
VITE_API_URL=

# ── Main-process launch env (NOT bundled into the renderer) ──
# Read by src/main/index.ts at launch — the bearer stays out of the DOM. Two
# Cloudflare Workers, both bearer-gated by the same APP_API_TOKEN:
#   AGENT_URL   → the agent Worker (agent:run → POST /v1/agent/:name)
#   API_URL     → the api Worker   (session:log → POST /v1/events, EU D1)
#   AGENT_TOKEN → the shared bearer both Workers check (a gate, not per-user auth)
# Agent url + token unset → the agent is off; api url + token unset → session logging is off.
AGENT_URL=
API_URL=
AGENT_TOKEN=
