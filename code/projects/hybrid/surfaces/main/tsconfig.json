{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["electron", "node"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@indiecrafts/packages-web-ui-components/*": [
        "../../../../packages/web/ui-components/src/*"
      ],
      "@indiecrafts/packages-shared-ui-icons/*": [
        "../../../../packages/shared/ui-icons/src/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
