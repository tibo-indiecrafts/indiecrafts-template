{
  "name": "@indiecrafts/web-tools-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:stories": "vitest run",
    "storybook:website": "storybook dev -p 6007 -c .storybook-website",
    "storybook:website:build": "storybook build -c .storybook-website -o storybook-static-website",
    "test:stories:website": "vitest run -c vitest.website.config.ts --passWithNoTests",
    "deploy:storybook:dev": "pnpm storybook:build && node ../../../../shared/scripts/deploy/worker.mjs storybook dev",
    "deploy:storybook:staging": "pnpm storybook:build && node ../../../../shared/scripts/deploy/worker.mjs storybook staging",
    "deploy:storybook:prod": "pnpm storybook:build && node ../../../../shared/scripts/deploy/worker.mjs storybook prod"
  },
  "dependencies": {
    "@indiecrafts/packages-web-announcement": "workspace:*",
    "@indiecrafts/packages-shared-config": "workspace:*",
    "@indiecrafts/packages-shared-compliance": "workspace:*",
    "@indiecrafts/packages-web-compliance": "workspace:*",
    "@indiecrafts/packages-web-system-pages": "workspace:*",
    "@indiecrafts/packages-web-ui-icons": "workspace:*",
    "@indiecrafts/packages-web-i18n": "workspace:*",
    "@indiecrafts/packages-web-locale-suggest": "workspace:*",
    "@indiecrafts/packages-web-ui": "workspace:*",
    "@indiecrafts/packages-web-ui-components": "workspace:*",
    "@indiecrafts/packages-web-ui-tokens": "workspace:*",
    "@indiecrafts/packages-shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/addon-themes": "^9.0.0",
    "@storybook/addon-vitest": "9.1.20",
    "@storybook/nextjs-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^9.0.0",
    "vite": "^6.0.0",
    "wrangler": "4.143.0"
  }
}
