{
  "name": "@indiecrafts/web-tools-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:stories": "vitest run",
    "storybook:website": "storybook dev -p 6007 -c .storybook-website",
    "storybook:website:build": "storybook build -c .storybook-website -o storybook-static-website",
    "test:stories:website": "vitest run -c vitest.website.config.ts",
    "storybook:app": "storybook dev -p 6008 -c .storybook-app",
    "storybook:app:build": "storybook build -c .storybook-app -o storybook-static-app",
    "test:stories:app": "vitest run -c vitest.app.config.ts",
    "storybook:mobile": "storybook dev -p 6009 -c .storybook-mobile",
    "storybook:mobile:build": "storybook build -c .storybook-mobile -o storybook-static-mobile",
    "test:stories:mobile": "vitest run -c vitest.mobile.config.ts",
    "storybook:hybrid": "storybook dev -p 6010 -c .storybook-hybrid",
    "storybook:hybrid:build": "storybook build -c .storybook-hybrid -o storybook-static-hybrid",
    "test:stories:hybrid": "vitest run -c vitest.hybrid.config.ts"
  },
  "dependencies": {
    "@indiecrafts/packages-web-announcement": "workspace:*",
    "@indiecrafts/packages-mobile-ui-native": "workspace:*",
    "@indiecrafts/packages-shared-announcement": "workspace:*",
    "@indiecrafts/packages-shared-compliance": "workspace:*",
    "@indiecrafts/packages-shared-config": "workspace:*",
    "@indiecrafts/packages-shared-logger": "workspace:*",
    "@indiecrafts/packages-shared-system-pages": "workspace:*",
    "@indiecrafts/packages-shared-ui-icons": "workspace:*",
    "@indiecrafts/packages-shared-version": "workspace:*",
    "@indiecrafts/packages-web-i18n": "workspace:*",
    "@indiecrafts/packages-web-locale-suggest": "workspace:*",
    "@indiecrafts/packages-web-ui": "workspace:*",
    "@indiecrafts/packages-web-ui-components": "workspace:*",
    "@indiecrafts/packages-web-version": "workspace:*",
    "@indiecrafts/packages-shared-ui-tokens": "workspace:*",
    "@indiecrafts/packages-shared-utils": "workspace:*",
    "react-intl": "^7.1.6"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/addon-themes": "^9.0.0",
    "@storybook/addon-vitest": "9.1.20",
    "@storybook/nextjs-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.7",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-web": "^0.19.13",
    "storybook": "^9.0.0",
    "vite": "^6.0.0"
  }
}
