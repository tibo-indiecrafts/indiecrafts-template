# =============================================================
# Environment variables. All optional — the template runs as-is
# without any of these set.
# =============================================================

# Production origin (scheme + host, no trailing slash), e.g.
# https://acme.com. Feeds `site.url` → canonical URLs, sitemap, JSON-LD,
# OG tags, and robots.txt. Set it ONLY on the production deployment: while
# unset the site keeps the placeholder origin, `isSiteConfigured` stays
# false, and robots.txt serves a full disallow (see below).
NEXT_PUBLIC_SITE_URL=

# First-party asset CDN base — fed into Next `assetPrefix`, so the app's OWN build
# assets (`/_next/*` + `/public`) load from a CDN. Empty = serve from the origin.
# Per-env (each env's build bakes its own; in CI set the per-env GitHub Environment
# var). Sanity content is NOT served here — Sanity images keep `cdn.sanity.io`.
NEXT_PUBLIC_CDN_URL=

# Per-deployment namespace — usually you DON'T set this; run `pnpm project:rename
# <slug>` instead, which writes `DEFAULT_SITE_PREFIX` in @indiecrafts/packages-shared-config AND the
# matching wrangler resource names. `site.prefix` reads this env first, so it's the
# escape hatch to override the namespace without editing code. It prefixes the
# consent record, the theme choice, and the locale cookie, so two clients never
# collide — MUST be unique per client. Empty = the config default ("indiecrafts").
NEXT_PUBLIC_SITE_PREFIX=

# Override the detected environment for `getCurrentEnvironment()` in
# `src/config/types.ts`. Drives the CSP in next.config.ts AND robots.txt:
# only "production" is indexable — every other environment (dev, preview,
# staging, test) serves `Disallow: /` so it stays quiet when online. Valid
# values: "development" | "test" | "staging" | "production". When unset,
# NODE_ENV decides. Set "staging" on preview deploys for the tighter CSP.
NEXT_PUBLIC_ENVIRONMENT=

# Minimum console log level, overriding the per-env default in @indiecrafts/packages-shared-config
# (`logging.levels`; prod defaults to "silent" = no console output). Set to
# "debug" to temporarily light up logs on a prod/staging deploy while chasing a
# bug. Values: trace | debug | info | warn | error | fatal | silent. Errors still
# reach the Sentry transport (if wired) regardless of this.
NEXT_PUBLIC_LOG_LEVEL=

# ── Authentication (Clerk) ──────────────────────────────────
# OPT-IN: leave both unset and auth is inert — the provider + proxy no-op and the
# site runs exactly as before (like Turnstile / Resend below). Set BOTH to turn it
# on. Passwordless (email OTP + social); the admin role rides the session token
# (Clerk Dashboard → Sessions → claim `{ "metadata": "{{user.public_metadata}}" }`).
# Publishable key — PUBLIC, safe in the browser bundle; the Clerk SDK reads this
# exact name. Get it at dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key — SERVER-ONLY, never NEXT_PUBLIC_, never shipped to the browser.
CLERK_SECRET_KEY=

# ── Audit sink (shared api → EU D1) ─────────────────────────
# The /api/session-log route forwards each sign-in to the shared api's /v1/events
# (EU D1 session log). API_URL = the api origin; APP_API_TOKEN = the bearer the api
# checks. Both SERVER-ONLY. Unset → session logging is off (the site still works).
API_URL=
APP_API_TOKEN=
# Client-exposed api-worker origin — the account-delete control (`/account`) posts
# straight from the browser to `${NEXT_PUBLIC_API_URL}/v1/erasure/self`. Non-secret
# (same origin value as API_URL above), but must carry the NEXT_PUBLIC_ prefix to
# reach the browser bundle. Unset → the /account page 404s (fail-safe).
NEXT_PUBLIC_API_URL=

# ── Sanity ──────────────────────────────────────────────────
# Public values — safe to expose. Find them at https://www.sanity.io/manage
# under your project's API tab. Required for the embedded Studio at /studio
# and for any `@/sanity/client` queries.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin API version so query semantics stay stable; bump intentionally.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Optional — where the embedded Studio mounts (@indiecrafts/packages-web-sanity env). Unset = "/studio".
# NEXT_PUBLIC_SANITY_STUDIO_BASE_PATH=/studio

# Server-only read token (Viewer role is enough). Required for draft-mode
# preview at /api/draft-mode/enable + the `sanityFetchLive` wrapper used
# by blog routes. Issue at sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=

# Optional browser-exposed preview token — shipped to the client during draft
# mode (`defineLive` browserToken). Set a dedicated minimal-scope (Viewer) token
# so the main read token never reaches the browser. Unset = falls back to
# SANITY_API_READ_TOKEN (preview still works).
SANITY_API_PREVIEW_TOKEN=

# Write token (Editor role) — used by `pnpm seed` to insert demo content AND,
# at RUNTIME by the /api/comments route (when `features.blogComments` is on) and
# the /api/newsletter route (when `features.newsletter` is on) to create the
# comment / subscriber docs (@indiecrafts/packages-web-sanity/write). Required in production
# if either is enabled. Prefer a dedicated, rotatable token; it is server-only
# (never exposed under NEXT_PUBLIC_).
# Also used by the Playwright app-journey e2e suite (`pnpm e2e`): its global-setup
# seeds a THROWAWAY `e2e` dataset (never `production`) via `scripts/seed-demo.mjs`.
# Override the dataset with E2E_SANITY_DATASET; set E2E_SKIP_SEED=1 to reuse one.
SANITY_API_WRITE_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────
# The secret for every transactional email — comment-moderation alerts, the
# newsletter double opt-in confirmation, and new-subscriber alerts. Turn each on
# + set recipients / From / copy in the Studio (→ E-mails); this key is the only
# piece that lives in the env. Server-only (never NEXT_PUBLIC_). The `From` must
# be a Resend-verified domain (publish its SPF + DKIM, add DMARC — else spam).
# Unset → emails are skipped, features still work. Verify delivery with Studio →
# E-mails → "Envoyer un test" (sends a sample of every enabled email).
# REUSING THE TEMPLATE: one key = one shared Resend account (shared quota, logs,
# and verified-domain list across every client). For real isolation, give each
# client its OWN Resend account/key — the per-site `From` (in Sanity) is not enough.
# RESEND_API_KEY=

# AI agent Worker — the browser posts the content-research demo to the standalone
# `code/shared/agent` Worker (its public origin). The `ANTHROPIC_API_KEY` + `TURNSTILE_SECRET`
# live on THAT Worker, never here. Set to the Worker origin — dev: `http://localhost:8787`
# (`wrangler dev` in code/shared/agent). It's a public endpoint → the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_AGENT_URL=https://indiecrafts-<env>-shared-agent.<subdomain>.workers.dev

# Cloudflare Turnstile — bot protection on the public forms (newsletter / waitlist /
# comments). OPT-IN: leave unset and the honeypot + in-app rate-limit stay the bot
# defense — the form guard (@indiecrafts/packages-shared-security) still enforces same-site origin +
# rate-limit + body-cap regardless. Set BOTH keys to turn it on: the form renders the
# widget (site key) and the server verifies the token (secret) — set only one and
# submissions are rejected. Create a widget at dash.cloudflare.com → Turnstile. The
# site key is public (client widget); the secret is server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Lead-magnet download link signing (@indiecrafts/packages-shared-gated-delivery). OPT-IN: a random
# server-only secret used to HMAC-sign the expiring `/api/download` token. Unset →
# lead-magnet delivery is off (a magnet-block signup still subscribes, just no file
# is e-mailed). Any long random string; keep it stable (rotating invalidates live
# links). Generate: `openssl rand -hex 32`. Never `NEXT_PUBLIC_`.
# LEAD_MAGNET_SECRET=

# Supabase MCP server (`.mcp.json`) — NOT used by the app; only powers the `supabase`
# MCP tool in Claude Code. Needs a personal access token (supabase.com → Account →
# Access Tokens) + the project ref (Project Settings → General). The server runs
# `--read-only` and pinned to this one project by default. Set both to enable the tool;
# leave unset to skip it.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
