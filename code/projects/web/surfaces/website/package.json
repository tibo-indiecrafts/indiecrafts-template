    "next": "16.3.4",
    "next-intl": "^4.13.6",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4",
