    "@indiecrafts/packages-web-ui-icons": "workspace:*",
    "@indiecrafts/packages-web-ui-tokens": "workspace:*",
    "@indiecrafts/packages-shared-utils": "workspace:*",
    "@indiecrafts/packages-web-announcement": "workspace:*",
    "@indiecrafts/packages-web-auth": "workspace:*",
    "@indiecrafts/packages-web-compliance": "workspace:*",
