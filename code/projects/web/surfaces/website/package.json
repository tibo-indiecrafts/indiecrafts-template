{
  "name": "@indiecrafts/web-surfaces-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "verify:quick": "pnpm tsc && pnpm lint",
    "verify:contrast": "node scripts/check-contrast.mjs",
    "verify": "pnpm tsc && pnpm lint && pnpm format:check && pnpm verify:contrast && pnpm doctor:changed && pnpm test",
    "test": "vitest run",
    "e2e": "E2E_TARGET=app playwright test",
    "e2e:ui": "E2E_TARGET=app playwright test --ui",
    "e2e:visual": "E2E_TARGET=visual playwright test",
    "e2e:update": "E2E_TARGET=visual playwright test --update-snapshots",
    "doctor": "npx react-doctor@latest --verbose",
    "doctor:changed": "npx react-doctor@latest --verbose --scope changed --base main",
    "shadscan": "pnpm dlx @shadscan/cli",
    "analyze": "ANALYZE=1 next build",
    "doctor:env": "node scripts/doctor-env.mjs",
    "seed": "node scripts/doctor-env.mjs --for=seed && node --env-file=.env.local scripts/seed-demo.mjs",
    "content:import": "node scripts/doctor-env.mjs && node --env-file=.env.local scripts/content-import.mjs",
    "subscribers:export": "node scripts/doctor-env.mjs && node --env-file=.env.local scripts/subscribers-export.mjs",
    "comments:export": "node scripts/doctor-env.mjs && node --env-file=.env.local scripts/comments-export.mjs",
    "waitlist:export": "node scripts/doctor-env.mjs && node --env-file=.env.local scripts/waitlist-export.mjs",
    "contact:export": "node scripts/doctor-env.mjs && node --env-file=.env.local scripts/contact-export.mjs",
    "version": "node scripts/version.mjs",
    "build:cf": "node scripts/version.mjs && NEXT_PUBLIC_EMBED_STUDIO=false opennextjs-cloudflare build",
    "preview:cf": "NEXT_PUBLIC_EMBED_STUDIO=false opennextjs-cloudflare preview",
    "project:rename": "node scripts/project-rename.mjs",
    "setup:kv": "node scripts/setup-kv.mjs",
    "studio:deploy": "sanity deploy",
    "deploy:website:dev": "node ../../../../shared/scripts/deploy/next.mjs website dev",
    "deploy:website:staging": "node ../../../../shared/scripts/deploy/next.mjs website staging",
    "deploy:website:prod": "node ../../../../shared/scripts/deploy/next.mjs website prod",
    "secrets:sync:website:dev": "node ../../../../shared/scripts/data/secrets.mjs website dev",
    "secrets:sync:website:staging": "node ../../../../shared/scripts/data/secrets.mjs website staging",
    "secrets:sync:website:prod": "node ../../../../shared/scripts/data/secrets.mjs website prod",
    "prepare": "",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.7.7",
    "@hookform/resolvers": "^5.8.0",
    "@indiecrafts/modules-web-blog": "workspace:*",
    "@indiecrafts/modules-web-contact": "workspace:*",
    "@indiecrafts/modules-web-newsletter": "workspace:*",
