    "@indiecrafts/packages-web-security-reports": "workspace:*",
    "@indiecrafts/packages-web-ui": "workspace:*",
    "@indiecrafts/packages-web-ui-components": "workspace:*",
    "@indiecrafts/packages-web-version": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
