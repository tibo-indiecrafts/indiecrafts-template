# =============================================================
# App surface environment. Same opt-in Clerk auth as the website.
# =============================================================

# ── Security (CSP) ──────────────────────────────────────────
CSP_MODE=enforce  # enforce (default) — the strict nonce CSP; set report-only to roll back
# CSP_TRUSTED_TYPES=report  # opt-in Trusted-Types Report-Only trial (enforce mode; reports, never blocks)

# ── Authentication (Clerk) — opt-in ─────────────────────────
# Leave both unset and auth is inert (the provider + proxy no-op). Set BOTH to turn
# it on. Same Clerk application + publishable key as the website (one user base, one
# admin role). Publishable key — PUBLIC, safe in the browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key — SERVER-ONLY, never NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# ── Audit sink (shared api → EU D1) ─────────────────────────
# The /api/session-log route forwards sign-ins to the shared api's /v1/events. Both
# SERVER-ONLY. Unset → session logging is off.
API_URL=
APP_API_TOKEN=

# ── Announcements (shared api → this app) ───────────────────
# The logged-in announcement banner/toast fetch the shared api's PUBLIC /v1/announcements.
# CLIENT-exposed (NEXT_PUBLIC_) — it is public content. Unset → no announcements show.
NEXT_PUBLIC_API_URL=
