    "deploy:app:dev": "node ../../../../shared/scripts/deploy/next.mjs app dev",
    "deploy:app:staging": "node ../../../../shared/scripts/deploy/next.mjs app staging",
    "deploy:app:prod": "node ../../../../shared/scripts/deploy/next.mjs app prod"
  },
  "dependencies": {
