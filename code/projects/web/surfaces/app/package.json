{
  "name": "@indiecrafts/web-surfaces-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "pnpm tsc",
    "build:cf": "node scripts/version.mjs && opennextjs-cloudflare build",
