# =============================================================
# Admin app environment. Clerk is REQUIRED before shipping — the
# admin-role gate (src/proxy.ts) is active only when it is set.
# =============================================================

# ── Security (CSP) ──────────────────────────────────────────
CSP_MODE=enforce  # enforce (default) — the strict nonce CSP; set report-only to roll back
# CSP_TRUSTED_TYPES=report  # opt-in Trusted-Types Report-Only trial (enforce mode; reports, never blocks)

# ── Authentication (Clerk) ──────────────────────────────────
# With NO publishable key the scaffold runs UNGATED — never deploy admin
# unconfigured. Set BOTH to turn the gate on. Grant the first admin from the Clerk
# Dashboard → Users → Public metadata → { "role": "admin" }, and add the session
# claim { "metadata": "{{user.public_metadata}}" } (Dashboard → Sessions).
# Publishable key — PUBLIC, safe in the browser bundle (the Clerk SDK reads this
# exact name). dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key — SERVER-ONLY, never NEXT_PUBLIC_, never shipped to the browser.
CLERK_SECRET_KEY=

# ── Audit sink (shared api → EU D1) ─────────────────────────
# Admin actions are POSTed to the shared api's /v1/events, which writes the EU D1
# audit store. API_URL = the deployed api origin; APP_API_TOKEN = the bearer the api
# checks (the same token set on the api worker). Unset → the audit falls back to a
# durable Cloudflare Workers-Logs line, so nothing is lost.
API_URL=
APP_API_TOKEN=

# ── System status screen (optional) ─────────────────────────
# The admin "System status" screen fetches each surface's /api/version and each HTTP
# worker's /health (the api /health also reports D1 status when given APP_API_TOKEN).
# Set the origins to show live status; unset → "not configured". API_URL is set above.
WEBSITE_URL=
APP_URL=
AGENT_URL=
