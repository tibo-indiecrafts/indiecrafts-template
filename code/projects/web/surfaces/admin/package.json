{
  "name": "@indiecrafts/web-surfaces-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "tsc": "tsc --noEmit",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx react-doctor@latest --verbose",
    "doctor:changed": "npx react-doctor@latest --verbose --scope changed --base main",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "pnpm tsc && pnpm lint && pnpm format:check && pnpm doctor:changed && pnpm test",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy:admin:dev": "node ../../../../shared/scripts/deploy/next.mjs admin dev",
    "deploy:admin:staging": "node ../../../../shared/scripts/deploy/next.mjs admin staging",
    "deploy:admin:prod": "node ../../../../shared/scripts/deploy/next.mjs admin prod"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.7",
    "@indiecrafts/packages-shared-auth": "workspace:*",
    "@indiecrafts/packages-shared-compliance": "workspace:*",
    "@indiecrafts/packages-shared-config": "workspace:*",
    "@indiecrafts/packages-shared-security": "workspace:*",
    "@indiecrafts/packages-shared-security-events": "workspace:*",
    "@indiecrafts/packages-web-ui-tokens": "workspace:*",
    "@indiecrafts/packages-shared-utils": "workspace:*",
    "@indiecrafts/packages-web-auth": "workspace:*",
    "@indiecrafts/packages-web-sanity": "workspace:*",
    "@indiecrafts/packages-web-security-reports": "workspace:*",
    "@indiecrafts/packages-web-ui": "workspace:*",
    "@indiecrafts/packages-web-ui-components": "workspace:*",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-intl": "^4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.36",
    "@indiecrafts/packages-web-quality-config": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "4.143.0"
  }
}
