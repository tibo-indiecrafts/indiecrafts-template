{
  "name": "@indiecrafts/mobile-surfaces-main",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "verify": "pnpm tsc && pnpm test",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "deploy:mobile:dev": "node ../../../../shared/scripts/deploy/expo.mjs dev",
    "deploy:mobile:staging": "node ../../../../shared/scripts/deploy/expo.mjs staging",
    "deploy:mobile:prod": "node ../../../../shared/scripts/deploy/expo.mjs prod"
  },
  "//": "SEPARATE PLATFORM: React Native / Expo. Deploys via EAS to the App/Play Store — NOT wrangler, NOT in deploy:all. Finalize versions on install (RN pins its own React major, older than the web apps' React 19; only React-FREE bricks are shared).",
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@clerk/clerk-expo": "^2",
    "@clerk/localizations": "^4.16.0",
    "@expo/metro-runtime": "~4.0.1",
    "@indiecrafts/packages-mobile-ui-native": "workspace:*",
    "@indiecrafts/packages-shared-announcement": "workspace:*",
    "@indiecrafts/packages-shared-compliance": "workspace:*",
    "@indiecrafts/packages-shared-config": "workspace:*",
    "@indiecrafts/packages-shared-format": "workspace:*",
    "@indiecrafts/packages-shared-query": "workspace:*",
    "@indiecrafts/packages-shared-system-pages": "workspace:*",
    "@indiecrafts/packages-shared-ui-fonts": "workspace:*",
    "@indiecrafts/packages-shared-ui-tokens": "workspace:*",
    "@indiecrafts/packages-shared-utils": "workspace:*",
    "@indiecrafts/packages-shared-version": "workspace:*",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~52.0.0",
    "expo-font": "~13.0.0",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "^7.1.6",
    "react-native": "0.76.5",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20",
    "@types/react": "~18.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "^5"
  }
