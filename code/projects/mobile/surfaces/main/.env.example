# =============================================================
# Mobile app environment (Expo). EXPO_PUBLIC_* is inlined into the
# app bundle — PUBLIC values only, never a secret.
# =============================================================

# ── Authentication (Clerk) — opt-in ─────────────────────────
# With no publishable key the app runs exactly as before (the provider is not
# mounted). Set it to turn on sign-in (email OTP + social). PUBLIC key only — the
# Clerk SECRET key never ships in a mobile binary. dashboard.clerk.com → API keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── AI agent Worker (shared/agent) + audit sink (shared api → EU D1) ─────────
# Two Cloudflare Workers, both bearer-gated by the same APP_API_TOKEN. EXPO_PUBLIC_*
# ships in the binary (public); the token is a bundle abuse-gate, not per-user auth.
#   EXPO_PUBLIC_AGENT_URL   → the agent Worker (lib/agent.ts, POST /v1/agent/:name)
#   EXPO_PUBLIC_API_URL     → the api Worker    (lib/session-log.ts, POST /v1/events;
#                             lib/announcements.ts, GET /v1/announcements — logged-in only)
#   EXPO_PUBLIC_AGENT_TOKEN → the shared bearer both Workers check
# Agent url + token unset → the agent is off; api url + token unset → session logging is off.
EXPO_PUBLIC_AGENT_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AGENT_TOKEN=

# ── Web surfaces (marketing site + account hand-off) ────────
# EXPO_PUBLIC_WEBSITE_URL → the marketing-site origin (legal link-out + version poll).
# "Manage account" opens the canonical web account in an in-app browser tab; it defaults
# to `${EXPO_PUBLIC_WEBSITE_URL}/account`. Set EXPO_PUBLIC_ACCOUNT_URL to override — e.g.
# the app surface, https://app.<domain>/account. Unset both → Manage account is hidden.
EXPO_PUBLIC_WEBSITE_URL=
EXPO_PUBLIC_ACCOUNT_URL=
